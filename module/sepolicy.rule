# OcCam F14 packaged measured rule. Existing types only: three allows,
# eight atomic checks (1 execute_no_trans + 4 vendor_xdsp chr_file +
# 3 adsprpcd file). The installer keeps this file when policy-capability
# exits 0, and replaces it with the exact subset whose groups completed
# when the probe exits 33. Loaded by the root manager BEFORE module scripts
# (Magisk: pre-init; KernelSU Next: on_post_data_fs). No permissive/type/
# typeattribute/xperm/genfscon/star statements. The optional power allow is
# absent. A retained sepolicy.cil does not by itself select this file.
allow hal_camera_default hal_camera_default_exec file execute_no_trans
allow priv_app vendor_xdsp_device chr_file { getattr open read ioctl }
allow priv_app adsprpcd_file file { getattr open read }
